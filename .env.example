# Generate a unique random value of at least 32 bytes and use the same value for authen-service, account-service, transaction-service, and notification-service.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes

# Generate a separate random value and use the same value for transaction-service and notification-service.
NOTIFICATION_API_KEY=replace-with-a-separate-random-interservice-key
AUTH_SERVICE_API_KEY=replace-with-a-third-random-interservice-key
ACCOUNT_SERVICE_API_KEY=replace-with-a-fourth-random-interservice-key

# SMTP relay configuration. Without credentials, inbox notifications still work but email delivery will fail visibly.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@riskeye.local
MAIL_SMTP_AUTH=true
ALERT_ADMIN_EMAIL=

CLIENT_ORIGIN=http://localhost:4200
EUREKA_URL=http://localhost:8761/eureka/
DB_USERNAME=pfe_user
DB_PASSWORD=pfe_pass
ACCOUNT_DB_URL=jdbc:postgresql://localhost:5432/account_db
AUTHEN_DB_URL=jdbc:postgresql://localhost:5432/authen_db
AUTHEN_DB_USERNAME=postgres
AUTHEN_DB_PASSWORD=1234
TRANSACTION_DB_URL=jdbc:postgresql://localhost:5432/transaction_db
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db